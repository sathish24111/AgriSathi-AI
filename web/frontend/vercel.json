{
  "version": 2,
  "name": "agrisathi-web-frontend",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "installCommand": "npm install",
  "framework": "vite",
  "routes": [
    {
      "src": "/download/(.*)",
      "dest": "/download/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}
